// Copy this file to Secrets.xcconfig and add your actual credentials
//
// Instructions:
// 1. Duplicate this file and rename it to: Secrets.xcconfig
// 2. Get your Supabase credentials from: https://supabase.com/dashboard
//    - Go to: Settings → API
//    - Copy "Project URL" and "anon public" key
// 3. Replace the placeholder values below
// 4. DO NOT commit Secrets.xcconfig to git (it's in .gitignore)
//
// Format: KEY = value (no quotes needed)

SUPABASE_URL = https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_KEY_HERE

// Example (DO NOT USE THESE):
// SUPABASE_URL = https://abcdefghijk.supabase.co
// SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
